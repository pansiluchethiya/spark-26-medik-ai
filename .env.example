# Medik Triage — Environment Variables

# --- Required ---
# Groq API key for fast AI inference (GPT-OSS 120B)
# Get: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional: Web Search ---
# Tavily API key for higher-quality medical search results
# Falls back to DuckDuckGo HTML search if not set
# Get: https://tavily.com/
# TAVILY_API_KEY=your_tavily_api_key_here

# --- Optional: Fallback Provider ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend → Backend wiring ---
# Base URL of the AI backend (Node.js server on OCI). Empty = same-origin.
# For production (Cloudflare Pages → OCI server):
VITE_BACKEND_URL=http://152.67.162.246
# Optional shared-secret header (must match BACKEND_API_KEY in backend/.env).
# VITE_BACKEND_API_KEY=

# --- Configuration ---
# Local dev server port (default: 4100)
DEMO_API_PORT=4100

# --- NOT USED (stripped for speed) ---
# AI_PROVIDER_ATTEMPTS, AI_PROVIDER_TIMEOUT_MS
# MISTRAL_API_KEY, MISTRAL_MODEL
# CEREBRAS_API_KEY, CEREBRAS_MODEL
# CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, CLOUDFLARE_MODEL
# OPENROUTER_API_KEY, OPENROUTER_MODEL
# These were removed for the focused triage-only build.
