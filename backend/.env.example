# Medik AI Backend — environment template.
# Copy to `.env` on the server (NEVER commit `.env`):
#   cp .env.example .env   # then fill in real keys, chmod 600 .env

# Port the backend listens on inside Docker / on the host
PORT=4100

# Comma-separated list of allowed frontend origins for CORS.
# Use * to reflect any origin (no cookies/credentials are used).
FRONTEND_URL=*

# --- Required: AI providers (same keys as the old Cloudflare setup) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional: web search quality + fallback providers ---
# TAVILY_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=qwen-3-27b
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free

# --- Spam protection: rate limits (per IP) ---
# Chat endpoint: max requests per minute
RATE_LIMIT_CHAT_PER_MINUTE=20
# Chat endpoint: max requests per hour
RATE_LIMIT_CHAT_PER_HOUR=200
# Global: max requests per 15 minutes (all routes)
RATE_LIMIT_GLOBAL_PER_15MIN=600

# --- Optional shared secret gate ---
# If set, POST /api/v1/ai/chat requires header `x-api-key: <value>`.
# Frontend sends it via VITE_BACKEND_API_KEY. Empty = disabled.
BACKEND_API_KEY=
